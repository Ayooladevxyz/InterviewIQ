{
  "schema_version": 1,
  "description": "CV analysis results schema template",
  "entity": "cv_analyses",
  "example": {
    "id": "<auto-generated serial>",
    "userId": "<foreign key: references users.id>",
    "filename": "<string: original CV filename>",
    "originalText": "<text: extracted CV content>",
    "score": "<number: 0-100 score from AI analysis>",
    "suggestions": "<array[string]: improvement suggestions>",
    "rewrittenVersion": "<text|null: optional AI-rewritten CV>",
    "createdAt": "<timestamp: auto-generated>"
  },
  "validations": {
    "userId": "required, must reference valid user",
    "filename": "required",
    "originalText": "required",
    "score": "required, 0-100",
    "suggestions": "required, array of strings",
    "rewrittenVersion": "optional"
  },
  "notes": [
    "Each analysis is linked to a user via userId",
    "Score is generated by Gemini AI",
    "Suggestions are stored as JSON array",
    "createdAt is auto-generated on insert"
  ]
}
