{
  "schema_version": 1,
  "description": "User account schema template",
  "entity": "users",
  "example": {
    "id": "<auto-generated serial>",
    "username": "<string: unique username>",
    "email": "<string: valid email address>",
    "password": "<string: hashed password>",
    "fullName": "<string|null: optional full name>",
    "createdAt": "<timestamp: auto-generated>"
  },
  "validations": {
    "username": "required, unique, min 3 characters",
    "email": "required, unique, valid email format",
    "password": "required, hashed using scrypt",
    "fullName": "optional"
  },
  "notes": [
    "Passwords are always hashed before storage",
    "Email and username must be unique across the system",
    "createdAt is auto-generated on insert"
  ]
}
